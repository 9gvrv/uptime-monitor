# Development values. Copy this file to `.env`.
#
# Production operations (migrations / studio) use a separate, gitignored
# `.env.production` containing only the production DATABASE_URL:
#   DATABASE_URL='postgresql://...'
#   pnpm db:migrate:prod
#
# The deployed Worker does NOT read either file: it uses the DATABASE_URL and
# JWT_SECRET set with `wrangler secret put`.

# Required
APP_NAME=
APP_VERSION=
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=

# Optional (defaults shown)
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
