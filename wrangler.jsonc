{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "ratelimits": [
    {
      // Unauthenticated `POST /api/v1/monitors/check/try` checks.
      "name": "DEV_RATE_LIMITER",
      // An identifier you define, that is unique to your Cloudflare account.
      // Must be an integer.
      "namespace_id": "1001",
      // Limit: the request threshold within a given period in a single
      // Cloudflare location. Requests can exceed this threshold.
      // Period: the duration of the period, in seconds. Must be either 10 or 60
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Authenticated `POST /api/v1/monitors/:id/check` checks. A separate
      // namespace gives it its own counters (20/minute instead of 10/minute).
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  // Declared so `wrangler dev` warns when a local `.dev.vars` is missing them,
  // and so generated types include them. Values are set with
  // `wrangler secret put <NAME>` — never committed here.
  "secrets": {
    "required": ["DATABASE_URL", "JWT_SECRET"]
  },

  // Structured logs are visible in `wrangler tail` and the dashboard.
  "observability": {
    "enabled": true
  },

  // Non-secret configuration. Secrets (DATABASE_URL, JWT_SECRET) are set with
  // `wrangler secret put <NAME>` and are NOT stored in this file.
  "vars": {
    "APP_NAME": "uptime-monitor",
    "APP_VERSION": "1.0.0",
    "NODE_ENV": "production",
    "LOG_LEVEL": "info"
  },

  "dev": {
    "port": 8787
  }
}
